<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_form_allowed_products" model="ir.ui.view">
        <field name="name">stock.warehouse.form.allowed.products</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group string="Control de productos" name="allowed_products">
                    <field name="allowed_product_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="allowed_category_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <div class="text-muted" colspan="2">
                        Si ambas listas están vacías, se permiten todos los
                        productos. De lo contrario, se permite un producto si
                        está seleccionado directamente o pertenece a una categoría
                        permitida, incluidas sus subcategorías. Los productos
                        seleccionados directamente se permiten aunque estén fuera
                        de esas categorías. La regla aplica a todas las ubicaciones
                        internas y de tránsito del almacén y sus sububicaciones.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
